{
  "expo": {
    "name": "Play2Gether",
    "slug": "play2gether",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "play2gether",
    "description": "Jouez à des mini-jeux amusants en duo ! Mot de Passe et plus encore.",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jordan.olv.play2gether",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Play2Gether a besoin d'accéder à tes photos pour enregistrer tes overlays de story.",
          "savePhotosPermission": "Play2Gether enregistre tes overlays de story dans tes photos.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "294f5754-29ae-4bc0-b051-d62b8e1d645d"
      }
    }
  }
}
